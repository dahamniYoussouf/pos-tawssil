{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "POS: Run Web (normal)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/pos_tawsil/run_pos.ps1",
        "normal"
      ],
      "options": {
        "cwd": "${workspaceFolder}/pos_tawsil",
        "env": {}
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "POS: Run Web (debug)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/pos_tawsil/run_pos.ps1",
        "debug"
      ],
      "options": { "cwd": "${workspaceFolder}/pos_tawsil" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "POS: Run Windows (exe)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/pos_tawsil/run_windows.ps1",
        "debug"
      ],
      "options": { "cwd": "${workspaceFolder}/pos_tawsil" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "POS: Flutter run -d windows",
      "type": "shell",
      "command": "flutter",
      "args": ["run", "-d", "windows"],
      "options": { "cwd": "${workspaceFolder}/pos_tawsil" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
  ]
}
