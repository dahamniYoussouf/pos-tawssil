# Gupshup WhatsApp Configuration
GUPSHUP_API_KEY=your_gupshup_api_key_here
GUPSHUP_SOURCE_NUMBER=your_whatsapp_business_number
GUPSHUP_OTP_TEMPLATE_ID=your_otp_template_id

# OTP Configuration (set via SystemConfig table)
# otp_request_use_paid_service=true/false

# Cache (global flag)
# Set CACHE_ENABLED=false to disable API caching (middleware + cacheService caches).
# Note: otp:* keys remain enabled for authentication OTP flow.
CACHE_ENABLED=true

# Database
# Local Postgres usually uses 5432. Hosted pooled connections often use 6432.
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resto_app
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_SSL=false

# Application timezone
APP_TIMEZONE=Africa/Algiers

# Partner email verification
PARTNER_EMAIL_VERIFICATION_REQUIRED=true
PARTNER_EMAIL_VERIFICATION_TTL_SECONDS=86400
PARTNER_EMAIL_VERIFICATION_BASE_URL=https://tawsilapp.com/api/auth/verify-email
PARTNER_PASSWORD_RESET_TTL_SECONDS=3600
PARTNER_PASSWORD_RESET_BASE_URL=https://tawsilapp.com/api/auth/password/reset
EMAIL_DEV_FALLBACK=true

# SMTP delivery
MAIL_FROM=no-reply@example.com
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Gmail OAuth2 delivery
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_OAUTH_EMAIL=your_gmail_address
GOOGLE_REDIRECT_URI=https://tawsilapp.com/api/auth/callback
